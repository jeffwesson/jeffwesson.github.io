{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 120,
  "useTabs": true,
  "tabWidth": 2,
  "singleQuote": true,
  "overrides": [
    {
      "files": ["*.json", "*.md", "*.yml", "*.yaml", "*.webmanifest"],
      "options": {
        "useTabs": false,
        "tabWidth": 2
      }
    }
  ]
}
