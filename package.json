{
  "name": "jeffwesson.github.io",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "postinstall": "npm run sync:skills",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "build": "vite build",
    "build:images": "node scripts/build-images.mjs",
    "check:wa-version": "node scripts/check-wa-version.mjs",
    "sync:skills": "rm -rf .claude/skills/webawesome .claude/skills/webawesome-design && mkdir -p .claude/skills && cp -R node_modules/@awesome.me/webawesome/dist/skills/. .claude/skills/"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "3.13.0",
    "prettier": "3.9.7",
    "sharp": "0.34.5",
    "vite": "8.3.0"
  }
}
